require('dotenv').config();

# Arquivo de configuração de variáveis de ambiente
# Copie este arquivo para .env e preencha com seus dados

# WhatsApp Bot Configuration
BOT_NAME=GrupoBot
BOT_PREFIX=!

# Grupo (opcional - apenas para grupos específicos)
TARGET_GROUP_ID=

# Logging
DEBUG=true
LOG_LEVEL=info

# Moderação
ENABLE_MODERATION=true
AUTO_REMOVE_SPAM=false
SPAM_THRESHOLD=5

# API Keys (se usar APIs externas para jogos/trivia)
TRIVIA_API_KEY=
JOKE_API_KEY=